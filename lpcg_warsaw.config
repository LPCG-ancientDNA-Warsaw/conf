/*
 * -------------------------------------------------
 *  Nextflow config file for LPCG (CeNT, Warsaw)
 * -------------------------------------------------
 * Use as follows:
 * nextflow run nf-core/eager -profile test, docker (or singularity, or conda)
 */

params {
  config_profile_name = 'LPCG - general profile'
  config_profile_description = 'Configuration file for the whole Laboratory of Paleogenetics and Conservation Genetics (LPCG) at the University of Warsaw'
  // Limit resources so that this can run on GitHub Actions
  max_cpus = 16
  max_memory = 25.GB
  max_time = 120.h
  
  common_files_path = "/mnt/workspace03/gr7001/share"
}

//cleanup = true

process {
		max_cpus = 32
		max_memory = 32.GB
		max_time = 144.h
	
	    maxRetries = 4

		withLabel:'mc_medium' {
			cpus = {8 * task.attempt}
			memory = {8.GB * task.attempt} 
			time = {120.h + 6.h * task.attempt}
		}
	  
		withName:'damageprofiler' {
			cpus = 8
			memory = {16.GB * task.attempt}
			time = {4.h * task.attempt}
			ext.args = '-Xmx12g'
		}
}